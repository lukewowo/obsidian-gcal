{
	"name": "obsidian-google-calendar-agenda",
	"version": "0.1.0",
	"description": "Query Google Calendar from a code block and render upcoming events as an agenda, list, or table.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "esbuild tests/spec.ts --bundle --platform=node --format=cjs --target=node20 --alias:obsidian=./tests/obsidian-shim.ts --outfile=tests/.build/spec.cjs --log-level=warning && node tests/.build/spec.cjs"
	},
	"keywords": [
		"obsidian",
		"google-calendar"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.14.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.5",
		"js-yaml": "^5.2.3",
		"moment": "^2.30.1",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.3",
		"typescript": "^5.5.0"
	}
}
